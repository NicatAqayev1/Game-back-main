<!-- Chart.js və Yerli Vaxt Skriptləri (Tam dəyişməz olaraq qorunub) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('performanceChart').getContext('2d');
    
    const labels = @Html.Raw(ViewBag.ChartLabels);
    const clicks = @Html.Raw(ViewBag.ClicksData);
    const ftds = @Html.Raw(ViewBag.FtdsData);

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Ümumi Kliklər',
                    data: clicks,
                    borderColor: 'rgb(59, 130, 246)',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    tension: 0.35,
                    fill: true,
                    pointBackgroundColor: 'rgb(59, 130, 246)'
                },
                {
                    label: 'Depozitlər (FTD)',
                    data: ftds,
                    borderColor: 'rgb(34, 197, 94)',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    borderWidth: 2,
                    tension: 0.35,
                    fill: true,
                    pointBackgroundColor: 'rgb(34, 197, 94)'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: {
                        color: '#f8fafc',
                        font: {
                            family: 'Inter',
                            size: 13
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        color: 'rgba(255, 255, 255, 0.04)'
                    },
                    ticks: {
                        color: '#94a3b8'
                    }
                },
                y: {
                    beginAtZero: true,
                    grid: {
                        color: 'rgba(255, 255, 255, 0.04)'
                    },
                    ticks: {
                        stepSize: 1,
                        color: '#94a3b8'
                    }
                }
            }
        }
    });

    // Yerli vaxt çevirici skript
    document.querySelectorAll('.local-time').forEach(function(el) {
        let utcDate = el.getAttribute('data-utc');
        if(utcDate) {
            let localDate = new Date(utcDate);
            el.innerText = localDate.toLocaleString();
        }
    });
</script>