@model IEnumerable<CasinoListDto>

    <div class="container my-5">
        <!-- Başlıq və Düymələr -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-white fw-bold">🎰 Kazino Brendləri</h2>
            <div class="d-flex gap-2">
